# Base URL of the Spring Boot backend used by all frontend API calls (see src/api/apiConfig.js).
# Copy this file to ".env" (or ".env.local") and adjust as needed. If left unset, the app
# auto-detects the backend at "<page protocol>//<page hostname>:8080", which already works
# for phone testing on the same Wi-Fi network without any configuration.

# Local development on the same machine:
VITE_API_BASE_URL=http://localhost:8080

# Testing from a phone/tablet on the same Wi-Fi network as your computer:
# replace with your computer's actual local IP address (e.g. from `ipconfig` / `ifconfig`).
# VITE_API_BASE_URL=http://192.168.1.X:8080
